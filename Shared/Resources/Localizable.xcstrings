    "Added photos and enabled built-in photos are included in the random rotation." : {
      "comment" : "A description of the photos that are included in the random rotation.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zur Zufallsauswahl gehören hinzugefügte Fotos und aktivierte integrierte Fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las fotos añadidas y las fotos integradas activadas se incluyen en la selección aleatoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les photos ajoutées et les photos intégrées activées sont incluses dans la sélection aléatoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le foto aggiunte e le foto integrate abilitate sono incluse nella rotazione casuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "追加した写真と有効な内蔵写真は、ランダムローテーションの対象になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "추가한 사진과 활성화된 내장 사진이 무작위 순환에 포함됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Добавленные фотографии и включённые встроенные фотографии участвуют в случайном выборе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "添加的照片和已启用的内置照片会加入随机轮换。"
          }
        }
      }
    },
